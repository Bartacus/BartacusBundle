Subject: [PATCH] Patch entry point for proper Symfony kernel bootstrap
---
Index: vendor/typo3/cms-cli/typo3
IDEA additional info:
Subsystem: com.intellij.openapi.diff.impl.patch.CharsetEP
<+>UTF-8
===================================================================
diff --git a/vendor/typo3/cms-cli/typo3 b/vendor/typo3/cms-cli/typo3
--- a/vendor/typo3/cms-cli/typo3	(revision f77b2858e1f01162a6707a8e929567ddc2473f80)
+++ b/vendor/typo3/cms-cli/typo3	(date 1781553805378)
@@ -19,6 +19,7 @@
  */
 call_user_func(function() {
     $classLoader = require ($GLOBALS['_composer_autoload_path'] ?? __DIR__ . '/../../autoload.php');
+    \Bartacus\Bundle\BartacusBundle\Bootstrap\SymfonyBootstrap::initKernel();
     \TYPO3\CMS\Core\Core\SystemEnvironmentBuilder::run(1, \TYPO3\CMS\Core\Core\SystemEnvironmentBuilder::REQUESTTYPE_CLI);
     \TYPO3\CMS\Core\Core\Bootstrap::init($classLoader, true)->get(\TYPO3\CMS\Core\Console\CommandApplication::class)->run();
 });
